        <Param val="5.0" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Welcome to a Motor Sequence Learning Experiment!&amp;#10;&amp;#10;In this experiment you have to choose between 4 keyboard responses-'Z','X','C','V'. In the experiment you will observe 4 rectanngular columns and one small triangle on one of these columns in each trial of the experiment. Your goal is to press the letter according to the appearance of the triangle on the column. For example, if the triangle appears on the left most column press 'Z', if it is on rightmost column then press 'V'." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
