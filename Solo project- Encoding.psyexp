        <Param val="$&quot;Was this digit &quot; + str(probe_digit) + &quot; present in the numbers presented before? &quot; &amp;#10;&quot;Please press 'y' for yes and 'n' for no&quot;&amp;#10;&amp;#10;" valType="str" updates="set every repeat" name="text"/>
