        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Welcome to the experiment!&amp;#10;&amp;#10;In this experiment you will be presented with a set of numbers and after that you will be presented with a single digit and you have to press 'y' if the number if the digit was present in the set of numbers and 'n' if the number was not presented.&amp;#10;&amp;#10;Please press the spacebar when you are ready!&amp;#10;&amp;#10;If you have any questions, please ask!&amp;#10;&amp;#10;All the best!!" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
